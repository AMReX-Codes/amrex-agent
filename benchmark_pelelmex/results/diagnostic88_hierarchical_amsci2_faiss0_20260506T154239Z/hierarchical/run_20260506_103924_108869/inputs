#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0             # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ
geometry.prob_lo     =  -0.02 -0.02 0.0        # x_lo y_lo (z_lo)
geometry.prob_hi     =   0.02 0.02 0.016        # x_hi y_hi (z_hi)

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = NoSlipWallAdiab NoSlipWallAdiab
peleLM.hi_bc = NoSlipWallAdiab NoSlipWallAdiab


#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 128 128 32        # Level 0 number of cells in each direction   
amr.v               = 1               # AMR verbose
amr.max_level       = 2               # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 2       # refinement ratio
amr.regrid_int      = 5               # how often to regrid
amr.n_error_buf     = 2 2 2 2         # number of buffer cells in error est
amr.grid_eff        = 0.7             # what constitutes an efficient grid
amr.blocking_factor = 16              # block factor in grid generation (min box size)
amr.max_grid_size   = 128             # max box size


#--------------------------- Problem -------------------------------
prob.P_mean = 101325.0
prob.standoff = -0.002
prob.pertmag = 0.0002
pmf.datafile = "drm19_pmf.dat"

#-------------------------PeleLM CONTROL----------------------------
peleLM.v = 1
peleLM.gravity = 0.0 -9.81 0.0
peleLM.run_mode = evaluate
# Note that the order in which those appears is important: calling velProj will overwrite the 
# velocity field provided in the initdata function for instance.
peleLM.evaluate_vars = velProj velForce avg_pressure diffTerm divU temp instRR transportCC divTau

# --------------- INPUTS TO CHEMISTRY REACTOR ---------------
peleLM.chem_integrator = "ReactorCvode"

#------------------------- EB SETUP -----------------------------
eb2.geom_type = sphere
eb2.sphere_radius = 1.0
eb2.sphere_center = 0.0
eb2.sphere_has_fluid_inside = 1
eb2.small_volfrac = 1.e-4
peleLM.refine_EB_type = Static
peleLM.refine_EB_max_level = 0
peleLM.refine_EB_buffer = 2.0

#--------------------REFINEMENT CONTROL------------------------
amr.refinement_indicators = yH
amr.yH.max_level     = 5
amr.yH.value_greater = 3.0e-7
amr.yH.field_name    = Y(H)

#--------------------LINEAR SOLVER CONTROL------------------------
nodal_proj.verbose = 2
nodal_proj.mg_max_coarsening_level = 6
nodal_proj.rtol = 2e-11

#amrex.fpe_trap_invalid = 1
#amrex.fpe_trap_zero = 1
#amrex.fpe_trap_overflow = 1

amr.check_int = 100
amr.plot_int = 100
amr.derive_plot_vars = avg_pressure
ode.rtol = 1e-06
ode.atol = 1e-05
cvode.max_order = 4
cvode.solve_type = denseAJ_direct
pmf.do_cellAverage = 0
peleLM.incompressible = 0
peleLM.rho = 1.17
peleLM.mu = 0.0
peleLM.use_wbar = 1
peleLM.num_divu_iter = 1
peleLM.num_init_iter = 3
peleLM.sdc_iterMax = 2
peleLM.floor_species = 0
peleLM.use_typ_vals_chem = 1
peleLM.do_temporals = 1
peleLM.do_mass_balance = 1
amr.max_step = 10
amr.stop_time = 1.0
amr.cfl = 0.15
amr.dt_shrink = 0.0001