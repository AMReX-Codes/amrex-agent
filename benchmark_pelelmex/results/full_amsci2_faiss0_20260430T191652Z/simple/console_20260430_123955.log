', 'llm_provider-x-openai-proxy-wasm': 'v0.1', 'llm_provider-x-ratelimit-limit-requests': '5000', 'llm_provider-x-ratelimit-limit-tokens': '5000000', 'llm_provider-x-ratelimit-remaining-requests': '4999', 'llm_provider-x-ratelimit-remaining-tokens': '4999770', 'llm_provider-x-ratelimit-reset-requests': '12ms', 'llm_provider-x-ratelimit-reset-tokens': '2ms', 'llm_provider-x-request-id': 'req_bc494101438941de9a7aa3bf1efe9e4d', 'llm_provider-content-encoding': 'gzip', 'llm_provider-alt-svc': 'h3=":443"; ma=86400', 'x-litellm-model-group': 'text-embedding-ada-002', 'x-litellm-attempted-retries': '0', 'x-litellm-attempted-fallbacks': '0', 'content-encoding': 'gzip', 'cf-cache-status': 'DYNAMIC', 'vary': 'accept-encoding', 'set-cookie': '__cf_bm=VX.CBaruaWtXWDGc11D55c7sa2_P.PU6h1P7PcMW.yU-1777578005.419711-1.0.1.1-SHDEcImCZk_HjEIoL02DOAK3cNPdx3LrzHJxeF8nV2Jn7feZz0NP5UhQDpcNDPEkTczPzDzLLkCs1yWzLKaXv4E27XBRVkEEX0PZWThTqXyUuHt8IPYJtVwCHuzJSg_u; HttpOnly; Secure; Path=/; Domain=american-science-cloud.org; Expires=Thu, 30 Apr 2026 20:10:05 GMT', 'cf-ray': '9f490425ddac7672-SEA'})
