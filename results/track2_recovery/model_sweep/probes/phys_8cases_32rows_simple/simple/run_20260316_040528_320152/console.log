a et al 1993\n#erf.fixed_fast_dt  = 0.125      # fixed time step [s] -- Straka et al 1993\n#erf.plot_int_1     = 200        # number of timesteps between plotfiles\n\nFILE: inputs_fft\n# ------------------  INPUTS TO MAIN PROGRAM  -------------------\nerf.prob_name = "Density Current"\n\nerf.init_type = Isentropic\n\nstop_time = 900.0\nmax_step  = 1\n\n#amr.blocking_factor_x = 16\n#amr.blocking_factor_y = 1\namr.blocking_factor_z = 32\n\nerf.plot_file_1 = plt\nerf.check_file  = chk\n\namr.max_grid_size_x = 1024\namr.max_grid_size_x = 32\n\nerf.anelastic   = 1\nerf.use_fft     = 1\nerf.check_file  = chk\nerf.plot_file_1 = plt\n\nerf.mg_v = 1\nerf.poisson_reltol = 1.e-12\nerf.poisson_abstol = 1.e-12\n\nerf.buoyancy_type = 2\n\namrex.fpe_trap_invalid = 1\n\nfabarray.mfiter_tile_size = 1024 1024 1024\n\ngeometry.prob_lo     = -12800.   0.    0.\ngeometry.prob_hi     =  12800. 100.  6400.\n\nxlo.type = Outflow\nxhi.type = Outflow\n\nzlo.type = SlipWall\n\nFILE: inputs_amr\n# ------------------  INPUTS TO MAIN PROGRAM  -------------------\nerf.prob_name = "Density Current"\n\nerf.init_type = Isentropic\n\nstop_time = 900.0\n\namr.blocking_factor_x = 16\namr.blocking_factor_y = 1\namr.blocking_factor_z = 16\n\n#erf.anelastic   = 1\n#erf.check_file  = chka\n#erf.plot_file_1 = plta\n\nerf.anelastic   = 0\nerf.check_file  = chk\nerf.plot_file_1 = plt\n\nerf.buoyancy_type = 2\n\namrex.fpe_trap_invalid = 1\n\nfabarray.mfiter_tile_size = 1024 1024 1024\n\n# PROBLEM SIZE & GEOMETRY\ngeometry.prob_lo     =      0.   0.    0.\ngeometry.prob_hi     =  25600. 100.  6400.\n\nxlo.type = "Symmetry"\nxhi.type = "Outflow"\n\nzlo.type = "SlipWall"\nzhi.type = "SlipWall"\n\ngeometry.is_periodic = 0 1 0\n\namr.max_level       = 1       # maximum level number allowed\n\namr.n_cell         = 128   1      32   # dx=dy=dz=100 m, Straka et al 1993 / Xue et al 2000\n\nFILE: inputs_crse_halfdomain_zlev\n# ------------------  INPUTS TO MAIN PROGRAM  -------------------\nerf.prob_name = "Density Curr