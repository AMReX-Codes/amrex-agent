{
  "version": "1.0",
  "contract_name": "mcp_prompt_to_plotfile",
  "description": "MCP tool flow from user prompt to generated plotfile visualizations",
  "transport": "stdio JSON-RPC (tools/list, tools/call)",
  "schema_path": "mcp_prompt_to_plotfile_schema.json",
  "example_path": "mcp_prompt_to_plotfile_example.json",
  "entrypoint_tool": "execute_workflow",

  "tool_sequence": [
    "create_simulation_plan",
    "run_simulation"
  ],
  "entrypoint_default_steps": [
    "create_simulation_plan",
    "run_simulation",
    "analyze_results",
    "generate_visualizations"
  ],

  "required_inputs": {
    "prompt": "str (natural language simulation request)",
    "output_dir": "str (optional; where inputs/run directories are created)",
    "submit": "dict (optional; must include dry_run=true for safe tests)"
  },

  "expected_outputs": {
    "create_simulation_plan": {
      "selected_case": "str",
      "inputs_file_path": "str",
      "run_directory": "str"
    },
    "run_simulation": {
      "job_status": "str",
      "run_directory": "str",
      "method": "str"
    }
  },
  "computation_output_location": "workflow_history[-1]['details']",

  "plotfile_expectations": {
    "source": "run_directory",
    "pattern": "plt* directories",
    "note": "Visualization backends discover plotfiles from run_directory"
  },

  "failure_modes": [
    "Missing inputs_file_path or case_dir for run_simulation",
    "Simulation did not produce plotfiles"
  ]
}
